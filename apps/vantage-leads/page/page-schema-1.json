{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PageDoc",
  "description": "`page/<key>.yaml` — a routable root document. Pages are unnamed and multi-instantiable; they receive `args.*`/`query.*` and publish nothing.",
  "type": "object",
  "required": [
    "body"
  ],
  "properties": {
    "body": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Component"
      }
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ChartParams": {
      "type": "object",
      "required": [
        "x"
      ],
      "properties": {
        "chart_type": {
          "description": "Chart shape. The headless render is always bars (fractions); the hosted chrome honours the shape.",
          "default": "bar",
          "allOf": [
            {
              "$ref": "#/definitions/ChartType"
            }
          ]
        },
        "label": {
          "description": "Caption shown above the chart.",
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "description": "Paint axis labels (hosted chrome). Off for dense dashboard tiles.",
          "default": true,
          "type": "boolean"
        },
        "series": {
          "description": "Layer columns for stacked shapes — each names a numeric column contributing one layer per point.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "value_labels": {
          "description": "Paint each point's value on the chart (hosted chrome).",
          "default": false,
          "type": "boolean"
        },
        "x": {
          "description": "Column supplying each point's label.",
          "type": "string"
        },
        "y": {
          "description": "Column supplying each point's value (numeric). Omit for stacked charts driven by `series:` alone.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ChartType": {
      "type": "string",
      "enum": [
        "bar",
        "pie",
        "line",
        "stacked_area"
      ]
    },
    "ColumnsSpec": {
      "description": "Grid column selection: a plain name list, or the legacy map form whose values carry per-column display hints (colour rules, …) — hints are host-interpreted, passed through as raw JSON.",
      "anyOf": [
        {
          "description": "`columns: [region, visitors]`",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "description": "`columns: { region: {}, live: { color: { green: [Live] } } }`",
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "Component": {
      "description": "Every placeable component. The enum is the definitive list: adding a kind means adding a variant here and a `ComponentDef` impl in `ui-component`.",
      "oneOf": [
        {
          "description": "`kind: column` — a container hosting children.",
          "type": "object",
          "required": [
            "children",
            "kind"
          ],
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Component"
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "column"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "`kind: row` — a horizontal container hosting children side by side.",
          "type": "object",
          "required": [
            "children",
            "kind"
          ],
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Component"
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "row"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "`kind: label` — renders a text template (`${...}` reads allowed).",
          "type": "object",
          "required": [
            "kind",
            "params"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "label"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "params": {
              "$ref": "#/definitions/LabelParams"
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "`kind: stat` — a single aggregate over an observation.",
          "type": "object",
          "required": [
            "kind",
            "observe"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "stat"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "observe": {
              "description": "Scenery this stat observes.",
              "allOf": [
                {
                  "$ref": "#/definitions/ObserveRef"
                }
              ]
            },
            "params": {
              "default": {
                "label": null
              },
              "allOf": [
                {
                  "$ref": "#/definitions/StatParams"
                }
              ]
            },
            "project": {
              "description": "Projected display: the stat shows `formula` evaluated over the last row's numeric columns (dt = 0 at capture; the projector animates dt between retakes) instead of the row count.",
              "anyOf": [
                {
                  "$ref": "#/definitions/ProjectionDef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "`kind: select` — a dropdown; when named, publishes its `value` output.",
          "type": "object",
          "required": [
            "kind",
            "params"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "select"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "observe": {
              "description": "Optional scenery the options come from (`params.column` values); omitted = static `params.options`.",
              "anyOf": [
                {
                  "$ref": "#/definitions/ObserveRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "params": {
              "$ref": "#/definitions/SelectParams"
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "`kind: list` — renders `item` once per row of `observe` (row scope: `row.*`), or, with `params.text`, a formatted record list (Rhai row formats — the host paints the real list widget with swatches/colour labels/highlight).",
          "type": "object",
          "required": [
            "kind",
            "observe"
          ],
          "properties": {
            "item": {
              "description": "Item template, instantiated per row. May be omitted when `params.text` formats rows instead.",
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/Component"
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "list"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "observe": {
              "description": "Scenery this list observes.",
              "allOf": [
                {
                  "$ref": "#/definitions/ObserveRef"
                }
              ]
            },
            "params": {
              "default": {
                "text": null,
                "label": null,
                "palette": null
              },
              "allOf": [
                {
                  "$ref": "#/definitions/ListParams"
                }
              ]
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "`kind: grid` — a tabular view over an observation. Rows re-render in place as the data moves; clicking a row selects it. When named, publishes `selected_id` (the selected row's `id_column` value).",
          "type": "object",
          "required": [
            "kind",
            "observe"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "grid"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "observe": {
              "description": "Scenery this grid observes.",
              "allOf": [
                {
                  "$ref": "#/definitions/ObserveRef"
                }
              ]
            },
            "params": {
              "default": {
                "columns": null,
                "id_column": null,
                "default_sort": null,
                "limit": null
              },
              "allOf": [
                {
                  "$ref": "#/definitions/GridParams"
                }
              ]
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "Grid with editing chrome: toolbar (new/edit/delete), editing modal, and row actions — same definition as `grid`, richer host widget.",
          "type": "object",
          "required": [
            "kind",
            "observe"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "crud"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "observe": {
              "description": "Scenery this grid observes.",
              "allOf": [
                {
                  "$ref": "#/definitions/ObserveRef"
                }
              ]
            },
            "params": {
              "default": {
                "columns": null,
                "id_column": null,
                "default_sort": null,
                "limit": null
              },
              "allOf": [
                {
                  "$ref": "#/definitions/GridParams"
                }
              ]
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "Master-detail composite: a crud grid whose selection reveals detail tabs (record form + one tab per declared relation) under a resizable split. Selection is INTERNAL (value-class) — no page remounts.",
          "type": "object",
          "required": [
            "kind",
            "observe"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "binder"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "observe": {
              "description": "Scenery this grid observes.",
              "allOf": [
                {
                  "$ref": "#/definitions/ObserveRef"
                }
              ]
            },
            "params": {
              "default": {
                "columns": null,
                "id_column": null,
                "default_sort": null,
                "limit": null
              },
              "allOf": [
                {
                  "$ref": "#/definitions/GridParams"
                }
              ]
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "`kind: chart` — a bar chart over an observation: one bar per row, `x` labels, `y` values scaled against the largest.",
          "type": "object",
          "required": [
            "kind",
            "observe",
            "params"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "chart"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "observe": {
              "description": "Scenery this chart observes.",
              "allOf": [
                {
                  "$ref": "#/definitions/ObserveRef"
                }
              ]
            },
            "params": {
              "$ref": "#/definitions/ChartParams"
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "`kind: form` — one record of `observe`, selected by the `record` template (typically a grid's `${<grid>.selected_id}`). The record id is a STRUCTURAL dependency: a new selection remounts the page and the form rebuilds over the new record.",
          "type": "object",
          "required": [
            "kind",
            "observe",
            "record"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "form"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "observe": {
              "description": "Scenery the record belongs to.",
              "allOf": [
                {
                  "$ref": "#/definitions/ObserveRef"
                }
              ]
            },
            "params": {
              "default": {
                "id_column": null
              },
              "allOf": [
                {
                  "$ref": "#/definitions/FormParams"
                }
              ]
            },
            "record": {
              "description": "Record id template, e.g. `\"${launches.selected_id}\"`.",
              "type": "string"
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "Hierarchical listing composite: a tree over a path-parameterized listing family. Selection and expand/collapse are INTERNAL, value-class — no remounts while browsing; only a new `root` remounts.",
          "type": "object",
          "required": [
            "kind",
            "observe"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "finder"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "observe": {
              "description": "Listing family this finder observes; per-path keys resolve against it.",
              "allOf": [
                {
                  "$ref": "#/definitions/ObserveRef"
                }
              ]
            },
            "params": {
              "default": {
                "root": null,
                "path_param": null,
                "columns": null,
                "limit": null
              },
              "allOf": [
                {
                  "$ref": "#/definitions/FinderParams"
                }
              ]
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "description": "`kind: view` — mounts a `view/<src>.yaml` fragment with `args`.",
          "type": "object",
          "required": [
            "kind",
            "src"
          ],
          "properties": {
            "args": {
              "description": "Arg expressions passed to the view (values may contain `${...}`).",
              "default": {},
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "view"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "src": {
              "description": "View document key (file stem under `view/`).",
              "type": "string"
            },
            "when": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "FinderParams": {
      "type": "object",
      "properties": {
        "columns": {
          "description": "Canonical `{name, kind, size, modified}` → source column. Defaults fit faker/local sources (identity mapping). A canonical column the source doesn't supply paints empty — `size` exists only where the source (or a dio-level augment, vantage-side) supplies it; the finder never opens a second observation for it.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "limit": {
          "description": "Max entries painted per node (default 100); cut entries are counted, never silent.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        },
        "path_param": {
          "description": "Datasource vocabulary for the per-path observation key (faker `path`, S3 `prefix`). Default `path`.",
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "description": "Root path template, e.g. `\"${args.path}\"` — STRUCTURAL: a new root remounts. Omitted/empty = the family's un-narrowed listing.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "FormParams": {
      "type": "object",
      "properties": {
        "id_column": {
          "description": "Column identifying records. Defaults to `id`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "GridParams": {
      "type": "object",
      "properties": {
        "columns": {
          "description": "Columns to show, in order. Omitted = every column of the first row.",
          "anyOf": [
            {
              "$ref": "#/definitions/ColumnsSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "default_sort": {
          "description": "Initial sort — a GRID param (the header arrow displays it; clicking headers re-sorts). Binding-script `.sort()` remains for widgets with no native sort UI (charts).",
          "anyOf": [
            {
              "$ref": "#/definitions/SortSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "id_column": {
          "description": "Column whose value identifies a row (feeds `selected_id`). Defaults to `id`, falling back to the first shown column when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Max rows painted (the binding's viewport caps hydration anyway). Defaults to 100; the renderer reports how many rows were cut.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        },
        "refresh_interval": {
          "description": "Periodic re-pull of the master scenery, in seconds — rows the server adds or updates show up without user action. Omitted = no auto-refresh.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "row_actions": {
          "description": "Right-click row actions (label + `copy:` column / `action:` Rhai body, optional `when:` predicate) — the legacy schema passed through as raw JSON, validated at host time.",
          "type": "array",
          "items": true
        },
        "toolbar": {
          "description": "Toolbar buttons rendered above the master grid (crud/binder).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ToolbarSpec"
          }
        },
        "views": {
          "description": "Custom read-only `view/<key>.yaml` tabs (binder only), shown before the auto-derived Details / relation tabs — a hand-authored summary is the headline.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "LabelParams": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "description": "Text template, e.g. `\"Currency: ${app.toolbar.default_currency}\"`.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ListParams": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Rhai row format for the trailing label (string, or a `#{ text, color }` map).",
          "type": [
            "string",
            "null"
          ]
        },
        "palette": {
          "description": "Palette spec for leading row swatches — host-interpreted (raw JSON passthrough; `{}` = the default palette)."
        },
        "text": {
          "description": "Rhai row format for the main text, e.g. `'region + \": \" + visitors'`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ObserveRef": {
      "description": "What an observing component observes. Plain string = the shared scenery over that table (sugar for `scenery(\"<key>\")`). The script forms shape the observation declaratively — sort, limit, traversal — resolved ONCE at bind time by the host: `scenery(\"top\").sort(\"visitors\", \"desc\").limit(10)`. Shaping lives here, on the observation, never as per-widget params.",
      "anyOf": [
        {
          "description": "`observe: top`",
          "type": "string"
        },
        {
          "description": "`observe: { script: ... }` or `observe: { file: shaped.rhai }`",
          "allOf": [
            {
              "$ref": "#/definitions/ShapedObserveRef"
            }
          ]
        }
      ]
    },
    "ProjectionDef": {
      "description": "`project:` — a Rhai formula the projector evaluates BETWEEN retakes (darkroom-side, per frame). Scope is the narrowest in the framework: the element's captured numeric anchors plus `dt`, seconds since the capture — nothing else.",
      "type": "object",
      "required": [
        "formula"
      ],
      "properties": {
        "formula": {
          "description": "Rhai over anchor values + `dt`, e.g. `\"alt + velocity * dt\"`.",
          "type": "string"
        },
        "max_dt": {
          "description": "Stop extrapolating past this many seconds of stale data — the display freezes at the last honest projection. Default 2.0.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "additionalProperties": false
    },
    "SelectParams": {
      "type": "object",
      "properties": {
        "all_label": {
          "description": "Extra first option meaning \"no filter\" (table-sourced).",
          "type": [
            "string",
            "null"
          ]
        },
        "column": {
          "description": "Column whose values become the options (table-sourced; default `name`).",
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "description": "Static options (ignored when `observe:` is set).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ShapedObserveRef": {
      "description": "A shaped observation source: exactly one of `script` or `file`. An enum rather than a struct of options so the generated schema REQUIRES a source — `observe: {}` fails validation instead of failing at runtime.",
      "anyOf": [
        {
          "description": "Inline Rhai producing a scenery spec, e.g. `observe: { script: 'scenery(\"top\").sort(\"visitors\", \"desc\")' }`.",
          "type": "object",
          "required": [
            "script"
          ],
          "properties": {
            "script": {
              "type": "string"
            }
          }
        },
        {
          "description": "`observe: { file: shaped.rhai }` — path relative to the project root.",
          "type": "object",
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            }
          }
        }
      ]
    },
    "SortDirection": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "SortSpec": {
      "type": "object",
      "required": [
        "column"
      ],
      "properties": {
        "column": {
          "type": "string"
        },
        "direction": {
          "default": "asc",
          "allOf": [
            {
              "$ref": "#/definitions/SortDirection"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "StatParams": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Caption shown next to the value.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ToolbarSpec": {
      "description": "A toolbar button above a crud/binder master grid: a label and a Rhai action body composing `actions.<name>(...)` / `tables.<name>` calls. Bodies that reference `row` render disabled (no row in toolbar scope).",
      "type": "object",
      "required": [
        "action",
        "label"
      ],
